# Aurora Operator — .gitignore
# Build outputs (regenerated by `dotnet build` / `dotnet publish`)
bin/
obj/
publish/
.vs/
*.user
*.suo
*.dll
*.pdb

# Release binaries (the .md docs in release/ ARE tracked; the installer
# and portable ZIP are build artifacts — rebuild with makensis / publish)
release/*.exe
release/*.zip

# Compiled installer output (rebuild with makensis; never commit binaries)
src/AuroraOperator.Installer/*.exe

# Generated icon binaries — regenerate with:
#   python3 src/AuroraOperator.App/Assets/build-icon.py
# (aurora.svg, the vector source, IS tracked)
*.ico
*.png

# Local data — never commit databases, logs or user data
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
