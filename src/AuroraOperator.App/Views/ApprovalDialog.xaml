<Window x:Class="AuroraOperator.App.Views.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approval required — Aurora Operator"
        Width="480" Height="470"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
               Text="Aurora needs your approval" />
    <TextBlock Grid.Row="1" Margin="0,4,0,12" Foreground="{DynamicResource MutedBrush}"
               TextWrapping="Wrap"
               Text="Review exactly what will happen before you approve it. Nothing runs until you decide." />

    <StackPanel Grid.Row="2">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedBrush}" />
      <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Exact command / change:" />
      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
        <TextBlock x:Name="ExactText" FontFamily="Consolas, 'Courier New', monospace"
                   TextWrapping="Wrap" />
      </Border>
      <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}">
        <Run Text="Permission: " />
        <Run x:Name="CategoryText" FontWeight="SemiBold" />
        <Run Text="    Risk: " />
        <Run x:Name="RiskText" FontWeight="SemiBold" />
      </TextBlock>
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap">
        <Run Text="Task: " />
        <Run x:Name="TaskIdText" FontFamily="Consolas, 'Courier New', monospace" />
      </TextBlock>
      <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap">
        <Run Text="Action: " />
        <Run x:Name="ActionIdText" FontFamily="Consolas, 'Courier New', monospace" />
      </TextBlock>
      <TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold">
        <Run Text="Expires in: " />
        <Run x:Name="ExpiryText" />
      </TextBlock>
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"
               TextWrapping="Wrap" FontSize="12"
               Text="Denying is always safe: the task stops and nothing is changed. Approving covers only this exact action — nothing else." />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="DenyButton" Content="Deny" Width="96" Height="34" Margin="0,0,8,0"
              Click="DenyButton_Click" />
      <Button x:Name="ApproveButton" Content="Approve" Width="96" Height="34"
              Background="{DynamicResource AccentBrush}" Foreground="#14161A"
              Click="ApproveButton_Click" />
    </StackPanel>
  </Grid>
</Window>
