<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E1E7F4"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#CFF7F9FF"/>
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#D3E8EEF9"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2D7E3F9"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#994D6593"/>
  <SolidColorBrush x:Key="TextBrush" Color="#192640"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#3C506F"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#304DA4"/>
  <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#654EB6"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#176B54"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#884717"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#A92A3D"/>
  <SolidColorBrush x:Key="TopBarBrush" Color="#B7EDF2FF"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#C9EDF3FF"/>
  <SolidColorBrush x:Key="UserMessageBrush" Color="#D3DCE7FA"/>
  <SolidColorBrush x:Key="AgentMessageBrush" Color="#B7FFFFFF"/>
  <SolidColorBrush x:Key="PopupBrush" Color="#EFF4FF"/>
  <LinearGradientBrush x:Key="AtmosphereBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B8C5D4FF" Offset="0"/>
    <GradientStop Color="#99EAF4FE" Offset="0.55"/>
    <GradientStop Color="#B4CEC7F6" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
