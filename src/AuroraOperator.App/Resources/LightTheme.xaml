<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Aurora Operator — light theme. Same keys as DarkTheme.xaml so the
       switch in MainWindow code-behind is a dictionary swap, nothing else. -->
  <Color x:Key="WindowBackgroundColor">#F4F6FB</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceMutedColor">#ECEEF1</Color>
  <Color x:Key="SurfaceHoverColor">#E2E5EA</Color>
  <Color x:Key="BorderColor">#D5D9DF</Color>
  <Color x:Key="TextPrimaryColor">#14161A</Color>
  <Color x:Key="TextMutedColor">#5B6470</Color>
  <Color x:Key="AccentColor">#334EA8</Color>
  <Color x:Key="AccentSecondaryColor">#7C3AED</Color>
  <Color x:Key="SuccessColor">#059669</Color>
  <Color x:Key="WarningColor">#B45309</Color>
  <Color x:Key="DangerColor">#DC2626</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFF" Opacity="0.92" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#ECEEF1" Opacity="0.96" />
  <SolidColorBrush x:Key="UserMessageBrush" Color="#D9F2EC" />
  <SolidColorBrush x:Key="AgentMessageBrush" Color="#FFFFFF" />

</ResourceDictionary>
