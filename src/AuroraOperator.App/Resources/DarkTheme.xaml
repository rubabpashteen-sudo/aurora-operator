<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Aurora Operator — dark theme. Mica-like feel comes from the flat
       charcoal surfaces plus a semi-transparent window background; there
       are deliberately no gradients anywhere in this UI. -->
  <Color x:Key="WindowBackgroundColor">#12151C</Color>
  <Color x:Key="SurfaceColor">#1A1F2B</Color>
  <Color x:Key="SurfaceMutedColor">#23262E</Color>
  <Color x:Key="SurfaceHoverColor">#2A2E38</Color>
  <Color x:Key="BorderColor">#2E323C</Color>
  <Color x:Key="TextPrimaryColor">#E8EAED</Color>
  <Color x:Key="TextMutedColor">#9AA0AA</Color>
  <Color x:Key="AccentColor">#A9BCFF</Color>
  <Color x:Key="AccentSecondaryColor">#A78BFA</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="DangerColor">#F87171</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#12151C" />
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <!-- Translucent top bar / panel brushes for the glass look. -->
  <SolidColorBrush x:Key="TopBarBrush" Color="#1A1F2B" Opacity="1" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#17191F" Opacity="1" />
  <SolidColorBrush x:Key="UserMessageBrush" Color="#263448" />
  <SolidColorBrush x:Key="AgentMessageBrush" Color="#1A1F2B" />

</ResourceDictionary>
