<Window x:Class="AuroraOperator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuroraOperator.Core;assembly=AuroraOperator.Core"
        xmlns:app="clr-namespace:AuroraOperator.App"
        Title="Aurora Operator" Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        Icon="Assets/aurora.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                  ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <app:StepStatusToBrushConverter x:Key="StepStatusToBrushConverter" />

    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#14161A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="TopBarButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#14161A" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <!-- ============ Top bar ============ -->
    <Grid Grid.Row="0" Background="{DynamicResource TopBarBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
          <Run Foreground="{DynamicResource AccentBrush}" Text="AURORA" />
          <Run Text=" OPERATOR" />
        </TextBlock>
        <Border Margin="14,0,0,0" Padding="8,3" CornerRadius="4"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center">
          <TextBlock FontSize="12" Text="{Binding CurrentModel}" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOllamaAvailable}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                   Text="Local AI" />
        <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" Text="{Binding OllamaStatus}" />
        <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center"
                   Text="{Binding MemoryUsageMB, StringFormat='RAM {0} MB'}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Command="{Binding ToggleThemeCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
              <Setter Property="Content" Value="Light theme" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                  <Setter Property="Content" Value="Dark theme" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Settings" Margin="8,0,0,0" Style="{StaticResource TopBarButtonStyle}"
                Command="{Binding SwitchPanelCommand}" CommandParameter="Settings" />
      </StackPanel>
    </Grid>

    <!-- ============ Main area ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <!-- Left sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Content="+  New Task" Margin="12,12,12,6" Height="38"
                  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewTaskCommand}" />
          <StackPanel Grid.Row="1" Margin="8,4">
            <Button Content="Recent Tasks" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Recent" />
            <Button Content="Projects" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Projects" />
            <Button Content="Files" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Files" />
            <Button Content="Memory" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Memory" />
            <Button Content="Model Manager" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="ModelManager" />
            <Button Content="Activity" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Activity" />
            <Button Content="Settings" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding SwitchPanelCommand}" CommandParameter="Settings" />
          </StackPanel>
          <TextBlock Grid.Row="2" Margin="16,0,16,14" FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Local-first. Your requests and files never leave this machine." />
        </Grid>
      </Border>

      <!-- Centre: chat + plan -->
      <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="180" />
          <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource AgentMessageBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource UserMessageBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" Text="{Binding Role}" />
                      <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                 Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,6">
          <TextBlock Text="Plan" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     Text="{Binding PlanSteps.Count, StringFormat='({0} steps)'}" />
        </StackPanel>

        <ListBox Grid.Row="2" Margin="20,0,20,8" ItemsSource="{Binding PlanSteps}"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding ToolName}" />
                    <Run Text=" — " />
                    <Run Text="{Binding Description}" />
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                             Text="{Binding ResultSummary}" />
                </StackPanel>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Text="{Binding Status}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar Grid.Row="3" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent" BorderThickness="0">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </Grid>

      <!-- Right panel -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="16,14,16,8" FontSize="14" FontWeight="SemiBold"
                     Text="{Binding ActivePanel}" />
          <Grid Grid.Row="1" Margin="16,0,16,16">
            <!-- Task (default) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Task">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="EXECUTION" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="VERIFICATION" />
                <TextBlock Text="{Binding VerificationStatus}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="FINAL REPORT" />
                <TextBlock Text="{Binding FinalReport}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="FILES USED" />
                <ItemsControl ItemsSource="{Binding FilesUsed}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="APPROVAL REQUESTS" />
                <ItemsControl ItemsSource="{Binding Approvals}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                          <TextBlock FontFamily="Consolas, 'Courier New', monospace" TextWrapping="Wrap"
                                     FontSize="12" Margin="0,6,0,0" Text="{Binding ExactCommandOrChange}" />
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Approve" Padding="12,5" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Deny" Padding="12,5"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Text="Approve or deny each request above. Denying stops the task safely." />
              </StackPanel>
            </ScrollViewer>

            <!-- Recent tasks -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Recent">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RECENT TASKS" />
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Double-click a task to load it back into the chat." />
                <ListBox x:Name="RecentTasksList" ItemsSource="{Binding RecentTasks}"
                         Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="RecentTasksList_MouseDoubleClick">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding UserRequest}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                          <Run Text="{Binding State}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Language}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>

            <!-- Projects -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Projects">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="PROJECTS" />
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Projects are derived from your recent tasks. Run a task and it appears here as a project entry." />
                <ItemsControl ItemsSource="{Binding RecentTasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding UserRequest}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Files -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Files">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FILES" />
                <Button Content="Attach files" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding AttachFileCommand}" />
                <ItemsControl ItemsSource="{Binding AttachedFiles}" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Memory -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Memory">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="MEMORY" />
                <TextBlock FontSize="13" TextWrapping="Wrap"
                           Text="{Binding RecentTasks.Count, StringFormat='{}{0} recent task(s) stored locally.'}" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Conversations and tasks are stored in a local SQLite database. Nothing is uploaded anywhere." />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding AppDataPath, StringFormat='Local data: {0}'}" />
                <Button Content="Clear conversation history" Margin="0,16,0,0"
                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                        Command="{Binding ClearMemoryCommand}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Model Manager -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="ModelManager">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="MODEL MANAGER" />
                <TextBlock FontSize="13" TextWrapping="Wrap">
                  <Run Text="Current model: " Foreground="{DynamicResource MutedBrush}" />
                  <Run Text="{Binding CurrentModel}" FontWeight="SemiBold" />
                </TextBlock>
                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding AvailableModels}"
                          DisplayMemberPath="DisplayLabel" SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedModel}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Switch" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding SwitchModelCommand}" />
                  <Button Content="Download" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding DownloadModelCommand}" />
                  <Button Content="Refresh" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding RefreshModelsCommand}" />
                </StackPanel>
                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Recommended: qwen3:4b on machines with 8 GB RAM or more, qwen3:1.7b below that. Models already on this PC are listed too — including ones that are not in the catalogue, marked 'Installed (not in catalog)' — and can be selected. Switch makes the selected model the default (saved, used from the next start). Download asks for your approval first, because it is a large download." />
              </StackPanel>
            </ScrollViewer>

            <!-- Activity -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Activity">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ACTIVITY — SYSTEM DIAGNOSTICS" />
                <Button Content="Refresh diagnostics" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding RefreshDiagnosticsCommand}" />
                <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                           Text="{Binding LastDiagnosticsSummary}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Settings">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SETTINGS" />
                <TextBlock FontSize="13" Text="Appearance" FontWeight="SemiBold" />
                <Button Content="Toggle light / dark theme" Margin="0,8,0,0"
                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                        Command="{Binding ToggleThemeCommand}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Ollama" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding OllamaBaseUrl, StringFormat='Server: {0}'}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding OllamaStatus}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Model context length" FontWeight="SemiBold" />
                <TextBox Margin="0,8,0,0" Width="120" HorizontalAlignment="Left"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding ContextLength, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Local data" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding AppDataPath}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Bottom input ============ -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="InputBox" Grid.Row="0" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" KeyDown="InputBox_KeyDown"
                 Style="{StaticResource InputTextBoxStyle}"
                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Attach" Style="{StaticResource ActionButtonStyle}"
                  Command="{Binding AttachFileCommand}" />
          <ToggleButton Grid.Column="1" Content="Screen context" Margin="8,0,0,0"
                        Style="{StaticResource ToggleButtonStyle}"
                        IsChecked="{Binding IsScreenContextEnabled}"
                        ToolTip="Include a UI Automation snapshot of the screen with the next request." />
          <ComboBox Grid.Column="2" Margin="8,0,0,0" Width="130" SelectedItem="{Binding Mode}"
                    ToolTip="Ask: answer only. Plan: show a plan and wait for approval. Autonomous: execute the plan.">
            <core:AgentMode>Ask</core:AgentMode>
            <core:AgentMode>Plan</core:AgentMode>
            <core:AgentMode>Autonomous</core:AgentMode>
          </ComboBox>
          <Button Grid.Column="4" Content="Stop" Style="{StaticResource ActionButtonStyle}"
                  Command="{Binding StopCommand}" />
          <Button Grid.Column="5" Content="Pause" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                  Command="{Binding PauseCommand}" />
          <Button Grid.Column="6" Content="Resume" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                  Command="{Binding ResumeCommand}" />
          <Button Grid.Column="7" Content="Send" Margin="8,0,0,0" Width="88"
                  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendCommand}" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============ Status bar ============ -->
    <Grid Grid.Row="3" Background="{DynamicResource SidebarBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="16,0,0,0" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Margin="0,0,16,0" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedBrush}" Text="Local-first  •  Ollama on localhost" />
    </Grid>
  </Grid>
</Window>
