<Window x:Class="AuroraOperator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuroraOperator.Core;assembly=AuroraOperator.Core"
        xmlns:app="clr-namespace:AuroraOperator.App"
        Title="Aurora Operator · RC 3" Width="1240" Height="800" MinWidth="730" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" Icon="Assets/aurora.ico"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <app:StepStatusToBrushConverter x:Key="StepStatusToBrushConverter"/>
  </Window.Resources>
  <Grid Background="{DynamicResource AtmosphereBrush}" Margin="0">
    <Grid Margin="16,12,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="1,0,1,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentBrush}">
            <Path Data="M 2,19 L 10,2 L 18,19 M 6,13 L 14,13" StrokeThickness="2.6" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource PrimaryButtonTextBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Aurora Operator" FontSize="20" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Margin="0,0,7,0" ToolTip="{Binding OllamaStatus}">
            <Ellipse.Style><Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsOllamaAvailable}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
              </DataTrigger></Style.Triggers>
            </Style></Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding CurrentModel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" ToolTip="{Binding OllamaStatus}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Sidebar" Click="ToggleNavigation" Style="{StaticResource TopBarButtonStyle}" ToolTip="Toggle navigation"/>
          <Button Content="Activity" Click="ToggleInspector" Margin="7,0,0,0" Style="{StaticResource TopBarButtonStyle}" ToolTip="Toggle details"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="NavigationColumn" Width="210"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="NavigationPanel" Style="{StaticResource GlassPanel}" Margin="0,0,12,0" Padding="12">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <Button Content="+  New conversation" Click="FocusComposer" Command="{Binding NewTaskCommand}"
                      Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,17"/>
              <TextBlock Text="WORKSPACE" Style="{StaticResource SectionHeaderStyle}" Margin="11,0,0,8"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource NavButtonStyle}"/>
              <Button Content="Settings" Command="{Binding SwitchPanelCommand}" CommandParameter="Settings" Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Button Content="Conversations" Command="{Binding SwitchPanelCommand}" CommandParameter="Recent" Style="{StaticResource NavButtonStyle}" ToolTip="Ctrl+F"/>
                <Button Content="Workspace" Command="{Binding SwitchPanelCommand}" CommandParameter="Projects" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Files" Command="{Binding SwitchPanelCommand}" CommandParameter="Files" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Models" Command="{Binding SwitchPanelCommand}" CommandParameter="ModelManager" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Task details" Command="{Binding SwitchPanelCommand}" CommandParameter="Task" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Diagnostics" Command="{Binding SwitchPanelCommand}" CommandParameter="Activity" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Local storage" Command="{Binding SwitchPanelCommand}" CommandParameter="Memory" Style="{StaticResource NavButtonStyle}"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource GlassPanel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ConversationScroll" Padding="22,20,22,8" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScroll_ScrollChanged">
              <Grid MaxWidth="850">
                <StackPanel Margin="7,35,7,20" VerticalAlignment="Center" MaxWidth="620"
                            Visibility="{Binding HasNoMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock Text="What are we working on?" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>
                  <TextBlock Text="Ask a question, plan a change, or let Aurora take an approved action on your PC."
                             FontSize="15" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>
                  <WrapPanel>
                    <Button Content="Open This PC" Tag="open my computer" Click="UseSuggestion" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="Open Chrome" Tag="open google chrome" Click="UseSuggestion" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="Choose workspace" Command="{Binding ChooseWorkspaceCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                  </WrapPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}" Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="15" Padding="15,11" Margin="0,0,0,10" BorderThickness="1"
                              BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Style><Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource AgentMessageBrush}"/>
                          <Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource UserMessageBrush}"/>
                            <Setter Property="Margin" Value="40,0,0,12"/>
                          </DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <TextBlock Text="{Binding Role}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                          <Button HorizontalAlignment="Right" Content="Copy" Padding="7,2" MinHeight="25" Style="{StaticResource TopBarButtonStyle}"
                                  Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding Content}"/>
                          <TextBox Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                   IsReadOnly="True" TextWrapping="Wrap" FontSize="14" Margin="-2,5,0,0" Text="{Binding Content, Mode=OneWay}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="17,0,17,14">
              <Border Style="{StaticResource GlassPanel}" Padding="12,7" Margin="0,0,0,8"
                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                  <StackPanel x:Name="ActivityDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Style="{StaticResource ActivityDot}"/><Ellipse Style="{StaticResource ActivityDot}" Width="4" Height="4"/>
                    <Ellipse Style="{StaticResource ActivityDot}" Width="3" Height="3"/>
                  </StackPanel>
                  <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasReviewPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Run plan" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunPlanCommand}"/>
                <Button Content="Discard" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding DiscardPlanCommand}"/>
              </StackPanel>
              <Border Style="{StaticResource GlassPanel}" Padding="9">
                <StackPanel>
                  <Grid>
                    <TextBox x:Name="InputBox" MinHeight="58" MaxHeight="134" AcceptsReturn="True" MaxLength="12000"
                             AutomationProperties.Name="Message" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="InputBox_KeyDown" Style="{StaticResource InputTextBoxStyle}"
                             Background="Transparent" BorderThickness="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="11,9" IsHitTestVisible="False" Text="Message Aurora…" Foreground="{DynamicResource MutedBrush}">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding InputText}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Content="Stop" Margin="6,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding StopCommand}"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                      <Button Content="Send" Style="{StaticResource PrimaryButtonStyle}" MinWidth="63" Command="{Binding SendCommand}"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                      <ComboBox Width="90" Margin="0,0,6,0" SelectedValuePath="Tag" SelectedValue="{Binding Mode}"
                                AutomationProperties.Name="Task mode" ToolTip="Ask replies. Plan previews. Agent runs approved actions.">
                        <ComboBoxItem Content="Ask" Tag="{x:Static core:AgentMode.Ask}"/>
                        <ComboBoxItem Content="Plan" Tag="{x:Static core:AgentMode.Plan}"/>
                        <ComboBoxItem Content="Agent" Tag="{x:Static core:AgentMode.Autonomous}"/>
                      </ComboBox>
                      <Button Content="Attach" Margin="0,0,6,0" Command="{Binding AttachFileCommand}" Style="{StaticResource TopBarButtonStyle}"/>
                      <Button Content="Folder" Margin="0,0,6,0" Command="{Binding ChooseWorkspaceCommand}" Style="{StaticResource TopBarButtonStyle}" ToolTip="{Binding WorkspaceName}"/>
                      <Button Content="Models" Command="{Binding SwitchPanelCommand}" CommandParameter="ModelManager" Style="{StaticResource TopBarButtonStyle}"/>
                    </WrapPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
              <TextBlock Margin="5,7,5,0" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Border>

      <Border x:Name="InspectorPanel" Grid.Column="2" Style="{StaticResource GlassPanel}" Margin="12,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="16,14,16,8" FontSize="14" FontWeight="SemiBold"
                     Text="{Binding PanelTitle}" />
          <Grid Grid.Row="1" Margin="16,0,16,16">
            <!-- Task (default) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Task">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="EXECUTION" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="Steps" />
<ItemsControl ItemsSource="{Binding PlanSteps}">
  <ItemsControl.ItemTemplate>
    <DataTemplate>
      <Border Margin="0,0,0,6" Padding="9" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </ItemsControl.ItemTemplate>
</ItemsControl><TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="VERIFICATION" />
                <TextBlock Text="{Binding VerificationStatus}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="FINAL REPORT" />
                <TextBlock Text="{Binding FinalReport}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="FILES USED" />
                <ItemsControl ItemsSource="{Binding FilesUsed}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionHeaderStyle}" Text="APPROVAL REQUESTS" />
                <ItemsControl ItemsSource="{Binding Approvals}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                          <TextBlock FontFamily="Consolas, 'Courier New', monospace" TextWrapping="Wrap"
                                     FontSize="12" Margin="0,6,0,0" Text="{Binding ExactCommandOrChange}" />
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Approve" Padding="12,5" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Deny" Padding="12,5"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Text="Sensitive actions pause for approval." />
              </StackPanel>
            </ScrollViewer>

            <!-- Recent tasks -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Recent">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Saved conversations" />
                <TextBox x:Name="HistorySearch" Margin="0,4,0,12" Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Search saved conversations"
                         Text="{Binding HistoryQuery, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Double-click a conversation or press Enter to reopen it." />
                <ListBox x:Name="RecentTasksList" KeyDown="RecentTasksList_KeyDown" ItemsSource="{Binding RecentTasks}"
                         Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="RecentTasksList_MouseDoubleClick">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding UserRequest}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                          <Run Text="{Binding State}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Language}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>

            <!-- Projects -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Projects">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Selected folder" />
                <TextBlock Text="{Binding WorkspaceName}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button Content="Choose folder…" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding ChooseWorkspaceCommand}" />
                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Text="Plan and Agent can work within this folder. File changes and opening Windows apps require approval." />
              </StackPanel>
            </ScrollViewer>

            <!-- Files -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Files">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FILES" />
                <Button Content="Attach files" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding AttachFileCommand}" />
                <ItemsControl ItemsSource="{Binding AttachedFiles}" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Memory -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Memory">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="MEMORY" />
                <TextBlock FontSize="13" TextWrapping="Wrap"
                           Text="{Binding RecentTasks.Count, StringFormat='{}{0} recent task(s) stored locally.'}" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Conversations and tasks are stored in a local SQLite database. Nothing is uploaded anywhere." />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding AppDataPath, StringFormat='Local data: {0}'}" />
                <Button Content="Clear conversations and tasks" Margin="0,16,0,0"
                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                        Command="{Binding ClearMemoryCommand}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Model Manager -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="ModelManager">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="MODEL MANAGER" />
                <TextBlock FontSize="13" TextWrapping="Wrap">
                  <Run Text="Current model: " Foreground="{DynamicResource MutedBrush}" />
                  <Run Text="{Binding CurrentModel}" FontWeight="SemiBold" />
                </TextBlock>
                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding AvailableModels}"
                          DisplayMemberPath="DisplayLabel" SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedModel}" />
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Switch" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding SwitchModelCommand}" />
                  <Button Content="Download" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding DownloadModelCommand}" />
                  <Button Content="Refresh" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                          Command="{Binding RefreshModelsCommand}" />
                </WrapPanel>
                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Choose an installed model and press Switch. Aurora checks what is installed at startup. Model downloads require approval." />
              </StackPanel>
            </ScrollViewer>

            <!-- Activity -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Activity">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ACTIVITY — SYSTEM DIAGNOSTICS" />
                <Button Content="Refresh diagnostics" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding RefreshDiagnosticsCommand}" />
                <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                           Text="{Binding LastDiagnosticsSummary}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePanel}" Value="Settings">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SETTINGS" />
                <TextBlock FontSize="13" Text="Appearance" FontWeight="SemiBold" />
                <Button Content="Toggle light / dark theme" Margin="0,8,0,0"
                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                        Command="{Binding ToggleThemeCommand}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Ollama" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding OllamaBaseUrl, StringFormat='Server: {0}'}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding OllamaStatus}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Model context (2,048–16,384 tokens)" FontWeight="SemiBold" />
                <TextBox Margin="0,8,0,0" Width="120" HorizontalAlignment="Left"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding ContextLength, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Text="Local data · unencrypted transcripts and task history" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="{Binding AppDataPath}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>